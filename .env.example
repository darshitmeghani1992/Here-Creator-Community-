# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The URL + anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the auto-close cron route (bypasses RLS). NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron ────────────────────────────────────────────────────────────────────
# Shared secret the /api/cron/close-rooms route requires as a Bearer token.
# Vercel Cron sends this automatically when set as an env var; generate any
# long random string.
CRON_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
# Absolute base URL, used for OAuth redirects. e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── PostHog (optional) ──────────────────────────────────────────────────────
# Leave blank to disable analytics entirely (all tracking becomes a no-op).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
